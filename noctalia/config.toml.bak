[shell]
offline_mode = false
telemetry_enabled = false
setup_wizard_enabled = false
polkit_agent = true
clipboard_enabled = true
clipboard_keep_from_closed_apps = true

[shell.launcher]
fetch_exchange_rates = true

[shell.screenshot]
save_to_file = false
copy_to_clipboard = true
pipe_to_command = false
pipe_command = ""

[shell.greeter_sync]
auto_sync = false

[wallpaper]
enabled = true

[wallpaper.default]
path = "/home/h4ni0/Downloads/wallpaper.jpeg"

[wallpaper.automation]
enabled = false

[theme]
mode = "dark"
source = "builtin"
builtin = "Dracula"
wallpaper_scheme = "m3-fruit-salad"

[theme.templates]
enable_builtin_templates = false
builtin_ids = []
enable_community_templates = false
community_ids = []

[notification]
enable_daemon = true

[osd]
enabled = true

[osd.kinds]
volume = true
volume_output = true
volume_input = true
brightness = true
wifi = true
bluetooth = true
power_profile = true
caffeine = true
nightlight = true
dnd = true
lock_keys = true
keyboard_layout = true
media = true
privacy = true
keyboard_backlight = true

[lockscreen]
enabled = true
fingerprint = false
allow_empty_password = false

[system.monitor]
enabled = true

[idle.behavior.lock]
timeout = 600
action = "lock"
enabled = true

[idle.behavior.screen-off]
timeout = 660
action = "screen_off"
enabled = true

[calendar]
enabled = false

[weather]
enabled = false

[audio]
enable_overdrive = false
enable_sounds = false

[brightness]
enable_ddcutil = false

[nightlight]
enabled = false
force = false

[location]
auto_locate = false
address = ""

[bar.main]
enabled = true
position = "top"
thickness = 34
margin_ends = 10
margin_edge = 6
padding = 10
widget_spacing = 4
radius = 12
background_opacity = 0.9
scale = 1.0
reserve_space = true
shadow = false
capsule = false
start = ["launcher", "workspaces"]
center = ["clock"]
end = ["net-up", "net-down", "volume", "input-volume", "cpu", "ram", "temp", "tray", "privacy", "power_profile", "session"]

[widget.workspaces]
display = "name"
max_label_chars = 1
style = "minimal"
focused_color = "primary"
occupied_color = "secondary"
empty_color = "outline"
urgent_color = "error"
change_color_on_hover = true
focused_output_only = false
scale = 1.15

[widget.clock]
format = "[ {:%H:%M} ]"
tooltip_format = "{:%A, %B %d, %Y}"
font_weight = 700

[widget.net-up]
type = "sysmon"
stat = "net_tx"
display = "text"
network_speed_unit = "auto"
network_speed_compact = true
label_min_width = 38

[widget.net-down]
type = "sysmon"
stat = "net_rx"
display = "text"
network_speed_unit = "auto"
network_speed_compact = true
label_min_width = 38

[widget.volume]
device = "output"
show_label = true

[widget.input-volume]
type = "volume"
device = "input"
show_label = true

[widget.cpu]
type = "sysmon"
stat = "cpu_usage"
display = "text"
label_min_width = 30

[widget.ram]
type = "sysmon"
stat = "ram_used"
display = "text"
label_min_width = 48

[widget.temp]
type = "sysmon"
stat = "cpu_temp"
display = "text"
label_min_width = 38

[widget.privacy]
hide_inactive = true
icon_spacing = 4

[dock]
enabled = false

[desktop_widgets]
enabled = false


[plugins]
enabled = []
auto_update = false

[[plugins.source]]
name = "official"
kind = "git"
location = "https://github.com/noctalia-dev/official-plugins"
enabled = false

[[plugins.source]]
name = "community"
kind = "git"
location = "https://github.com/noctalia-dev/community-plugins"
enabled = false
